# --- PostgreSQL (Data Warehouse + métadonnées Airflow/Superset) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=etudiants_db
DB_USER=etudiants_user
DB_PASSWORD=etudiants_password

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_moi
# Clé partagée webserver/scheduler (sinon les logs des tâches ne s'affichent pas)
AIRFLOW_SECRET_KEY=etudiantssupersetsecretkey

# --- Superset ---
SUPERSET_SECRET_KEY=etudiantssupersetsecretkey


# --- Source des données ---
# generateur : données simulées (défaut) | apogee : exports réels déposés dans data/raw
ETL_SOURCE=generateur
# Format des exports réels (ex : latin-1 et ; pour un export Oracle)
CSV_ENCODING=utf-8
CSV_DELIMITER=,


# --- Superset : rôle PostgreSQL en lecture seule ---
BI_PASSWORD=change_moi
